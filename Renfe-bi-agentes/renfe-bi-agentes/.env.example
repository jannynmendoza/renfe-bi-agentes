# Copia este archivo a .env y rellena tu clave (solo necesaria para agents/run_agentes.py)
ANTHROPIC_API_KEY=sk-ant-...
# Modelo para los agentes (opcional)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Base de datos Supabase (PostgreSQL). Supabase > Project > Connect > Session pooler.
# Si se define, el servidor MCP lee los datos de Supabase en lugar de data/*.csv
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Forzar el origen de datos: supabase | csv (opcional)
# RENFE_BI_ORIGEN=csv
